<Slide id="images" background="#FFFFFF">
    <Box id="images/frame" class="frame">
      <Text id="images/kicker" class="kicker">IMAGE / FIT / RESOURCE ALIAS</Text>
      <Text id="images/title" class="title">同一张图片，三种尺寸策略。</Text>
      <Text id="images/intro" style="height:70px;font-size:22px;line-height:34px;color:#536B78">下方使用项目自制的确定性测试图。Asset 别名映射到显式加载的 PNG 字节。</Text>
      <Box id="images/grid" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;height:300px">
        <Box id="images/contain-card" style="display:flex;flex-direction:column;gap:16px;padding:16px;background:#EFF5F3">
          <Text id="images/contain-label" style="height:36px;font-size:22px;line-height:32px;font-weight:700">Contain / 完整显示</Text>
          <Image id="images/contain" src="palette" style="width:100%;height:190px;object-fit:contain"/>
        </Box>
        <Box id="images/cover-card" style="display:flex;flex-direction:column;gap:16px;padding:16px;background:#EFF5F3">
          <Text id="images/cover-label" style="height:36px;font-size:22px;line-height:32px;font-weight:700">Cover / 居中裁切</Text>
          <Image id="images/cover" src="palette" style="width:100%;height:190px;object-fit:cover"/>
        </Box>
        <Box id="images/fill-card" style="display:flex;flex-direction:column;gap:16px;padding:16px;background:#EFF5F3">
          <Text id="images/fill-label" style="height:36px;font-size:22px;line-height:32px;font-weight:700">Fill / 填满画框</Text>
          <Image id="images/fill" src="palette" style="width:100%;height:190px;object-fit:fill"/>
        </Box>
      </Box>
    </Box>
  </Slide>
