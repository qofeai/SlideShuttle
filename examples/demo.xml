<Deck title="让想法成为演示 / Ideas into presentations" font-family="Noto Sans CJK SC">
  <Token name="ink" value="#142B36"/>
  <Token name="accent" value="#09A88F"/>
  <Style name="frame">width:100%;height:100%;padding:48px 56px;display:flex;flex-direction:column;gap:24px</Style>
  <Style name="eyebrow">font-size:16px;line-height:24px;color:#6C8290</Style>
  <Style name="title">font-size:42px;line-height:56px;font-weight:700;color:var(--ink)</Style>
  <Style name="body">font-size:22px;line-height:34px;color:#536B78</Style>
  <Component name="Principle">
    <Box id="card" style="height:250px;padding:28px;background:#FFFFFF;border-radius:16px;display:flex;flex-direction:column;gap:16px">
      <Text id="number" style="height:30px;font-size:18px;line-height:28px;color:var(--accent)">${number}</Text>
      <Text id="heading" style="height:40px;font-size:28px;line-height:38px;font-weight:700;color:var(--ink)">${heading}</Text>
      <Text id="copy" style="height:104px;font-size:20px;line-height:32px;color:#536B78">${copy}</Text>
    </Box>
  </Component>
  <Slide id="cover" background="#0E2631">
    <Box id="cover/frame" class="frame" style="gap:20px">
      <Text id="cover/label" style="height:28px;font-size:16px;line-height:26px;color:#68DBC8">SLIDESHUTTLE    /    NATIVE PRESENTATIONS</Text>
      <Box id="cover/main" style="display:grid;grid-template-columns:7fr 5fr;gap:50px;height:450px">
        <Box id="cover/story" style="display:flex;flex-direction:column;justify-content:center;gap:26px">
          <Text id="cover/title" style="height:176px;font-size:62px;line-height:82px;font-weight:700;color:#FFFFFF">让想法<br/>成为演示。</Text>
          <Text id="cover/subtitle" style="height:90px;font-size:23px;line-height:36px;color:#AFC7D0">用模型熟悉的编排方式，<br/>生成可以继续修改的 PowerPoint。</Text>
        </Box>
        <Group id="cover/illustration" style="height:420px;position:relative">
          <Box id="cover/back-card" style="position:absolute;left:20px;top:65px;width:365px;height:265px;background:#204552;border-radius:20px"/>
          <Box id="cover/front-card" style="position:absolute;left:0;top:25px;width:365px;height:265px;background:#F3F8F6;border-radius:20px"/>
          <Text id="cover/card-title" style="position:absolute;left:28px;top:48px;width:300px;height:40px;font-size:22px;line-height:34px;font-weight:700;color:#142B36">A clear idea. A native slide.</Text>
          <Shape id="cover/bar-a" style="position:absolute;left:30px;top:171px;width:65px;height:75px;background:#ACE7DC;border-radius:6px"/>
          <Shape id="cover/bar-b" style="position:absolute;left:117px;top:136px;width:65px;height:110px;background:#58CAB5;border-radius:6px"/>
          <Shape id="cover/bar-c" style="position:absolute;left:204px;top:100px;width:65px;height:146px;background:#09A88F;border-radius:6px"/>
          <Path id="cover/arrow" d="M 0 50 C 35 45 50 8 100 0 L 84 1 M 100 0 L 97 17" viewBox="100 60" style="position:absolute;left:210px;top:310px;width:145px;height:80px;border:3px solid #68DBC8"/>
          <Text id="cover/annotation" style="position:absolute;left:0;top:345px;width:260px;height:38px;font-size:18px;line-height:30px;color:#68DBC8">布局一次，多端输出。</Text>
        </Group>
      </Box>
      <Box id="cover/footer" style="display:flex;justify-content:space-between;height:34px">
        <Text id="cover/meta" style="width:750px;height:30px;font-size:16px;line-height:26px;color:#83A3B0">Rust · Flex / Grid · CJK shaping · PNG / PDF / PPTX</Text>
        <Text id="cover/page" style="width:100px;height:30px;font-size:16px;line-height:26px;text-align:right;color:#83A3B0">01 / 03</Text>
      </Box>
    </Box>
  </Slide>
  <Slide id="principles" background="#EFF5F3">
    <Box id="principles/frame" class="frame">
      <Text id="principles/label" style="height:28px;font-size:16px;line-height:26px;color:var(--accent)">DESIGN PRINCIPLES / 设计原则</Text>
      <Text id="principles/title" class="title" style="height:66px">让 Agent 表达意图，让引擎确定布局。</Text>
      <Text id="principles/intro" class="body" style="height:76px">保留网页编排的组合能力，把演示文稿需要的尺寸、字体与可编辑性变成明确约束。</Text>
      <Box id="principles/cards" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;height:250px">
        <Use id="intent" component="Principle" number="01 / COMPOSE" heading="组合，而非堆坐标" copy="用容器、间距、对齐与组件描述关系，让内容变化带动布局。"/>
        <Use id="render" component="Principle" number="02 / RESOLVE" heading="中文原生排版" copy="显式提供字体，统一文字整形和几何，再输出 PNG 与 PDF。"/>
        <Use id="native" component="Principle" number="03 / EDIT" heading="保留原生对象" copy="文字、形状、表格和数据图表，作为真实对象进入 PPTX。"/>
      </Box>
      <Text id="principles/note" style="height:62px;font-size:18px;line-height:30px;color:#6C8290">格式独立设计。导入采用有限重建，不能表达的内容进入明确的损失清单。</Text>
    </Box>
  </Slide>
  <Slide id="data" background="#FFFFFF">
    <Box id="data/frame" class="frame" style="gap:20px">
      <Text id="data/label" style="height:28px;font-size:16px;line-height:26px;color:var(--accent)">DATA, NOT SCREENSHOTS / 保留数据</Text>
      <Text id="data/title" class="title" style="height:66px">同一份数据，连接预览与交付。</Text>
      <Box id="data/content" style="display:grid;grid-template-columns:7fr 5fr;gap:40px;height:360px">
        <Chart id="data/chart" type="bar" style="height:350px">
          <Labels>第一轮|第二轮|第三轮|第四轮</Labels>
          <Series name="示例方案 A" color="#09A88F">28 45 63 82</Series>
          <Series name="示例方案 B" color="#B1D9D1">20 30 48 61</Series>
        </Chart>
        <Box id="data/details" style="display:flex;flex-direction:column;gap:20px">
          <Text id="data/table-title" style="height:40px;font-size:26px;line-height:36px;font-weight:700;color:var(--ink)">交付对象的性质</Text>
          <Table id="data/table" columns="1 1" style="background:#FFFFFF;height:252px;font-size:18px;line-height:28px;color:#142B36">
            <Row style="background:#EBF0F8;font-weight:700"><Cell>对象</Cell><Cell>PPTX 表达</Cell></Row>
            <Row><Cell>标题与正文</Cell><Cell>原生文本框</Cell></Row>
            <Row><Cell>结构化数据</Cell><Cell>表格 / 图表</Cell></Row>
            <Row><Cell>复合图形</Cell><Cell>原生分组</Cell></Row>
          </Table>
        </Box>
      </Box>
      <Box id="data/callout" style="padding:18px 22px;height:90px;background:#EFF5F3;border-radius:12px">
        <Text id="data/footnote" style="font-size:18px;line-height:28px;height:56px;color:#536B78">图表数据为演示用示例，不代表性能测试结果。Office / WPS 中的实际渲染与编辑行为仍需独立验收。</Text>
      </Box>
    </Box>
  </Slide>
</Deck>
