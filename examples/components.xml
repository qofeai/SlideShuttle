<Deck title="SlideShuttle 渲染能力与可选组件" font-family="Noto Sans CJK SC">
  <Asset id="palette" src="palette.png"/>
  <Token name="ink" value="#142B36"/>
  <Token name="accent" value="#087E6D"/>
  <Style name="frame">width:100%;height:100%;padding:48px 56px;display:flex;flex-direction:column;gap:20px</Style>
  <Style name="title">height:66px;font-size:42px;line-height:56px;font-weight:700;color:var(--ink)</Style>
  <Style name="kicker">height:28px;font-size:16px;line-height:26px;color:var(--accent)</Style>
  <Component name="BulletRow">
    <Box id="row" style="display:flex;align-items:start;gap:12px;flex-shrink:0">
      <Text id="marker" style="flex-shrink:0;white-space:nowrap;color:var(--accent)">•</Text>
      <Text id="content" style="flex-grow:1;flex-basis:0;min-width:0">${text}</Text>
    </Box>
  </Component>
  <Slide src="pages/components/typography.xml"/>
  <Slide src="pages/components/images.xml"/>
  <Slide src="pages/components/data.xml"/>
</Deck>
